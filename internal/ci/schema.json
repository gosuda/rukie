{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rukie://schemas/ci-job-file/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "job"
  ],
  "properties": {
    "schema": {
      "const": "rukie.ci/v1"
    },
    "triggers": {
      "$ref": "#/$defs/triggers"
    },
    "land": {
      "$ref": "#/$defs/land"
    },
    "job": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/job"
      }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}$"
    },
    "triggers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "change": {
          "type": "boolean"
        },
        "push": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "land": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "schedule": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "cron",
              "branch"
            ],
            "properties": {
              "cron": {
                "type": "string",
                "maxLength": 64
              },
              "branch": {
                "type": "string",
                "maxLength": 128
              }
            }
          }
        }
      }
    },
    "land": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/name"
          }
        }
      }
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "runs_on",
        "image",
        "steps"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "runs_on": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,30}$"
          }
        },
        "image": {
          "type": "string",
          "pattern": "^[a-z0-9._/-]+(:[A-Za-z0-9._-]+)?@sha256:[0-9a-f]{64}$"
        },
        "needs": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/name"
          }
        },
        "timeout": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,2}(m|h)$"
        },
        "network": {
          "enum": [
            "none",
            "egress"
          ]
        },
        "secrets": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
          }
        },
        "effects": {
          "enum": [
            "none",
            "idempotent",
            "exclusive"
          ]
        },
        "pure": {
          "type": "boolean"
        },
        "interruptible": {
          "type": "boolean"
        },
        "retry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max",
            "on"
          ],
          "properties": {
            "max": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            },
            "on": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "infra",
                  "lost",
                  "timeout",
                  "script_failure"
                ]
              }
            }
          }
        },
        "env": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "pattern": "^[A-Z_][A-Z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 4096
          }
        },
                "artifacts": {"type": "array", "maxItems": 16,
                      "items": {"type": "string", "minLength": 1, "maxLength": 512,
                                "pattern": "^[^/]"}},
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "run"
            ],
            "properties": {
              "name": {
                "$ref": "#/$defs/name"
              },
              "run": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              }
            }
          }
        },
        "matrix": {
          "type": "object",
          "maxProperties": 8,
          "propertyNames": {
            "pattern": "^[A-Z_][A-Z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "maxLength": 4096
            }
          }
        }
      },
      "if": {
        "required": [
          "pure"
        ],
        "properties": {
          "pure": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "network": {
            "const": "none"
          },
          "effects": {
            "const": "none"
          },
          "secrets": {
            "maxItems": 0
          }
        }
      }
    }
  }
}
